-const patch = require('../data/patch.json');
+// Patched for Bun --compile compatibility (subkit): replace the
+// `createRequire`-based runtime require with a static ESM JSON
+// import so `bun build --compile` embeds patch.json into the
+// binary's virtual filesystem. The upstream form
+//   const require = createRequire(import.meta.url);
+//   const patch = require('../data/patch.json');
+// can't be statically resolved by any bundler.
+import patch from "../data/patch.json" with { type: "json" };
 
 export default patch;
