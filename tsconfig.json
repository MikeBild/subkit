{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@engine/*": ["./apps/engine/src/*"],
      "@shared/*": ["./packages/shared/src/*"],
      "@cli-core/*": ["./packages/cli-core/src/*"],
      "@chat-ui/*": ["./packages/chat-ui/src/*"]
    }
  },
  "include": [
    "apps/engine/src/**/*.ts",
    "apps/engine/src/**/*.tsx",
    "apps/engine/src/**/*.d.ts",
    "apps/engine/scripts/check-mutation-floor.ts",
    "apps/engine/scripts/prepare-mutation-run.ts",
    "apps/engine/scripts/run-core-tests.ts",
    "apps/sk/src/**/*.ts",
    "apps/sk/src/**/*.tsx",
    "packages/shared/src/**/*.ts",
    "packages/cli-core/src/**/*.ts",
    "packages/chat-ui/src/**/*.ts",
    "packages/chat-ui/src/**/*.tsx",
    "drizzle.config.ts",
    "apps/clipper/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "docs"]
}
