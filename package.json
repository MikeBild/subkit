{
  "name": "subkit",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch apps/engine/src/index.ts",
    "build:engine": "bun build apps/engine/src/index.ts --compile --define \"BUILD_VERSION=\\\"$(node -p 'require(\"./package.json\").version')\\\"\" --outfile dist/engine && sh scripts/codesign-macos.sh dist/engine",
    "build:agent": "bun build apps/agent/src/index.ts --compile --define \"BUILD_VERSION=\\\"$(node -p 'require(\"./package.json\").version')\\\"\" --outfile dist/tunnel-agent && sh scripts/codesign-macos.sh dist/tunnel-agent",
    "build:cli": "bun build apps/cli/src/index.ts --compile --define \"BUILD_VERSION=\\\"$(node -p 'require(\"./package.json\").version')\\\"\" --outfile dist/subkit && sh scripts/codesign-macos.sh dist/subkit",
    "build:sk": "bun build apps/sk/src/index.ts --compile --define \"BUILD_VERSION=\\\"$(node -p 'require(\"./package.json\").version')\\\"\" --outfile dist/sk && sh scripts/codesign-macos.sh dist/sk",
    "build:all": "bun run build:engine && bun run build:agent && bun run build:cli && bun run build:sk",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:unit": "SKIP_DOCKER=1 SKIP_DB_TESTS=1 bun test apps/engine/src/observability apps/engine/src/logging apps/engine/src/audit apps/engine/src/llm apps/engine/src/workflows apps/engine/src/execution/tests",
    "test:integration": "bun test apps/engine/src/db apps/engine/src/queue apps/engine/src/http apps/engine/src/webhooks apps/engine/src/credentials/oauth2",
    "test:e2e": "bun run build:cli && bun run build:sk && bun test tests/e2e/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run apps/engine/src/db/migrate.ts",
    "gen:openapi-client": "bun run scripts/gen-openapi-client.ts",
    "db:seed": "bun run apps/engine/src/db/seed.ts",
    "db:issue-admin-key": "bun run apps/engine/src/db/issue-admin-key.ts",
    "compose:up": "sh scripts/ensure-env.sh && docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:reset": "docker compose down -v && sh scripts/ensure-env.sh && docker compose up -d --build",
    "metrics": "curl -sS http://localhost:${PORT:-3000}/metrics"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@bradenmacdonald/s3-lite-client": "^0.9.6",
    "@clack/prompts": "^1.2.0",
    "@hono/node-server": "^1.19.14",
    "@hono/otel": "^1.1.1",
    "@hono/zod-openapi": "^1.3.0",
    "@inkjs/ui": "^2.0.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@slack/web-api": "^7.15.1",
    "ai": "^6.0.159",
    "boxen": "^8.0.1",
    "cheerio": "^1.2.0",
    "citty": "^0.2.2",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "cockatiel": "^3.2.1",
    "conf": "^15.1.0",
    "dayjs": "^1.11.20",
    "deepmerge-ts": "^7.1.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "env-paths": "^4.0.0",
    "eventsource-parser": "^3.0.6",
    "fast-json-patch": "^3.1.1",
    "find-up": "^8.0.0",
    "fuse.js": "^7.3.0",
    "globby": "^16.2.0",
    "hono": "^4.12.12",
    "hono-rate-limiter": "^0.5.3",
    "ink": "^7.0.0",
    "ink-markdown": "^1.0.4",
    "jose": "^6.2.2",
