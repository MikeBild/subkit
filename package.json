    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@biomejs/biome": "^2.4.11",
    "@electric-sql/pglite": "^0.4.4",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
