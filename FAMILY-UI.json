  "attention": {
    "titleId": "attention",
    "classes": [
      "stopped",
      "failing",
      "decide"
    ],
    "order": "class-then-next-deadline-then-oldest",
    "oneEntryPer": "subject",
    "entryAnatomy": [
      "subject",
      "reason",
      "since"
    ],
    "entrySentences": 1,
    "actionsPerEntry": {
      "primary": 1,
      "secondaryMax": 1
    },
    "emptyState": "all-clear-only-when-all-readable-sources-answered",
    "unreadableSources": "named-never-all-clear",
    "noReadableSource": "first-visible-navigation-entry",
    "statusLine": "only-when-empty",
    "statusLineContent": [
      "health-state",
      "next-scheduled-run"
    ],
    "zeroTiles": 0,
    "badge": "entry-count",
    "historyLink": "exactly-one-audit-link",
    "excluded": [
      "warnings",
      "test-and-authoring-failures",
      "unused-keys"
    ],
    "reviewSheet": {
      "address": "?review=<id>",
      "decideInPlace": true,
      "afterDecision": "entry-leaves-immediately-toast-links-audit",
      "cardSlots": [
        "decision-meta",
        "decision-title",
        "decision-effect",
        "decision-source",
        "decision-details",
        "decision-actions"
      ],
      "rowTitleCharactersMax": 120,
      "rowEffectCharactersMax": 160,
      "technicalDetailsCollapsed": true,
      "engineWording": "review-sheet-only",
      "rawIdentifiersOnPrimarySurface": false,
      "rawErrorsOnPrimarySurface": false,
      "history": "audit-link-only"
    },
    "health": {
      "states": [
        "healthy",
        "limited",
        "critical",
        "unknown"
      ],
      "home": "status-line-when-empty",
      "causes": "attention-entries",
      "componentsAndScore": "api-mcp-prometheus-only"
    },
    "freshness": "entry-only-when-stale",
    "refresh": {
      "recommendedSecondsMin": 10,
      "recommendedSecondsMax": 300,
      "pauseWhenDocumentHidden": true,
      "retainPreviousValues": true
    },
    "metrics": {
      "home": "usage",
      "figures": [
        "executions",
        "success-rate",
        "connector-health",
        "repair-rate"
      ],
      "drilldown": "list-counting-the-same-thing-same-window-and-filter",
      "countZeroLinks": false
    }
  },
  "states": [
    "loading",
    "empty",
    "ready",
    "partial",
    "error",
    "forbidden",
    "stale",
    "unknown",
    "contract-mismatch"
  ],
  "domContract": {
    "surface": "data-family-surface",
    "slot": "data-family-slot",
    "state": "data-family-state",
    "kpiId": "data-family-kpi-id",
    "kpiValueState": "data-family-kpi-value-state",
    "kpiSeverity": "data-family-kpi-severity",
    "kpiKind": "data-family-kpi-kind",
    "kpiLink": "data-family-kpi-link",
    "kpiTooltip": "data-family-kpi-tooltip",
    "visualization": "data-family-visualization",
    "contractVersion": "data-family-contract-version",
    "decisionKind": "data-family-decision-kind",
    "decisionPriority": "data-family-decision-priority",
    "collectionId": "data-family-collection-id",
    "collectionTier": "data-family-collection-tier",
    "collectionCapability": "data-family-collection-capability",
    "collectionRow": "data-family-collection-row",
    "collectionMobileCard": "data-family-collection-mobile-card",
    "failureKind": "data-family-failure-kind",
    "authContract": "data-auth-contract",
    "authProduct": "data-auth-product",
    "authProvider": "data-auth-provider"
  },
  "auth": {
    "flow": "direct-provider-choice",
    "locale": [
      "de",
      "en"
    ],
    "localeSource": "cookie-then-accept-language",
    "fallbackLocale": "en",
    "returnPath": "current-cockpit-path-and-query",
    "productIdentity": "real-cockpit-favicon-and-canonical-product-name",
    "providerOrder": [
      "sso",
      "api-key"
    ],
    "footer": "{Product} · OAuth 2.1",
    "intermediateSpaSignIn": false
  },
  "failures": {
    "notFound": {
      "transport": "spa-shell-http-200",
      "shellRetained": true,
      "actions": [
        "attention"
      ],
      "technicalDetails": false
    },
    "fatalError": {
      "shellActions": [
        "retry",
        "attention"
      ],
      "bootstrapActions": [
        "retry"
      ],
      "technicalDetails": false,
      "productionCrashRoute": false
    },
    "outsideCockpit": "html-page-for-browsers-api-envelope-otherwise"
  },
  "integration": {
    "rest": {
      "method": "GET",
      "path": "/v1/attention",
      "schemaVersion": "attention.v1",
      "readOnly": true,
      "perEntryPermission": true,
      "sourceStates": [
        "answered",
        "failed",
        "not_permitted"
      ]
    },
    "mcp": {
      "tool": "get_attention",
      "readOnly": true,
      "metricsTool": "get_operational_overview"
    },
    "metrics": {
      "path": "/metrics",
      "scope": "metrics:read",
      "servicePrincipalPerProduct": true,
      "authenticatedPrincipalRateLimitExempt": true,
      "highCardinalityLabelsAllowed": false
    },
    "restMetrics": {
      "method": "GET",
      "path": "/v1/operational-overview",
      "schemaVersion": "operational-overview.v1",
      "optional": true,
      "purpose": "metrics-for-siblings-and-prometheus",
      "p95MsMax": 500
    }
  },
  "collections": {
    "pageMeasure": "workbench",
    "primary": {
      "requiredCapabilities": [
        "search",
        "relevant-filters",
        "sort",
        "column-visibility",
        "result-count",
        "pagination",
        "url-state",
        "responsive-cards",
        "loading-state",
        "empty-state",
        "error-state"
      ],
      "defaultPageSize": 25,
      "pageSizeOptions": [
        25,
        50,
        100
      ],
      "stickyToolbar": false,
      "horizontalScrollDesktop": "last-resort"
    },
    "embedded": {
      "requiredCapabilities": [
        "sort-when-useful",
        "responsive-cards",
        "loading-state",
        "empty-state",
        "error-state"
      ],
      "pagination": "only-when-more-than-25",
      "columnVisibility": "not-required",
      "urlState": "not-required"
    },
    "rowHeightDesktopPx": {
      "minimum": 44,
      "maximum": 72
    },
    "mobileCardGapPx": 12,
    "rawIdentifiers": "secondary-only",
    "technicalText": "collapsed-or-detail-only",
    "rowOpen": "name-link-plus-row-click",
    "namedOpenButton": false,
    "rowTabStop": false,
    "menuGlyphOnlyForRealMenus": true,
    "mobileCard": "title-link-no-nested-links-row-actions-visible",
    "listHeaderCounts": false
  },
  "visualLanguage": {
    "spacingGridPx": 4,
    "radius": "16px",
    "border": "1px",
    "shadow": "none",
    "accent": "family",
    "actions": {
      "primary": {
        "variant": "default",
        "backgroundToken": "primary",
        "foregroundToken": "primary-foreground",
        "hoverOpacityPercent": 90
      },
      "secondary": {
        "variant": "outline"
      },
      "tertiary": {
        "variant": "ghost"
      },
      "link": {
        "variant": "link",
        "foregroundToken": "accent"
      },
      "destructive": {
        "variant": "destructive",
        "foregroundToken": "destructive"
      }
    },
    "semanticColors": {
      "critical": "red",
      "urgent": "orange",
      "healthy": "green",
      "information": "blue",
      "unknown": "gray"
    },
    "motion": "functional-only",
    "focusRing": "2px"
  },
  "release": {
    "mode": "atomic-family",
    "suspendedUntil": "every-sibling-at-3.0",
    "whileSuspended": "per-product; siblings on 2.3 keep serving operational-overview, SubKit on 3.0 keeps serving it too",
    "mismatchToleranceMinutes": 15,
    "mismatchMutationPolicy": "disabled",
    "rollback": "whole-family"
  },
  "screenshots": {
    "viewports": [
      "desktop",
      "mobile"
    ],
    "themes": [
      "light",
      "dark"
    ],
    "consecutiveRuns": 2,
    "products": 6,
    "attentionImagesPerAcceptedRelease": 48,
    "updateDashboardAfterEveryAttempt": true
  },
  "migration": {
    "from": "2.3",
    "to": "3.0",
    "siblingsMustImplement": [
      "Replace the overview tiles and the decisions page with one start page at /cockpit named Übersicht (Overview): a header with a 24h/7d/30d window switch (24h default), an operations bar of exactly six figures (runs, success rate, healthy connectors as of now, repairs applied, cost in the window, budget for the calendar month), each linking to the filtered list or page of the same window and never a bare 0, then the attention list: one entry per subject, classes stopped > failing > decide, one sentence, one primary action, at most one secondary link.",
      "Keep the operations bar in the calm state; the usage page shows consumption, cost, budget and runtime, never the run, success, connector and repair figures a second time.",
      "Serve GET /v1/attention (attention.v1) with per-entry permission checks and per-source status answered|failed|not_permitted; MCP get_attention returns the same list; digest and MCP connect summary render from it.",
      "Show 'all clear' plus one status line only when every source the reader may read answered; otherwise name what did not answer.",
      "Move deciding into a review sheet addressed by ?review=<id>; the entry leaves on decision and a toast links the audit trail.",
      "Drop the system page; health causes become entries, components and score stay in API, MCP and Prometheus.",
      "Navigation badge = number of attention entries; list headers carry no counts.",
      "Collection rows: the name cell is a real link, the row is clickable, no named Open button, the menu glyph only for a real menu.",
      "Redirect the old overview, decisions and system addresses to /cockpit.",
      "Keep serving /v1/operational-overview (operational-overview.v1) as optional metrics."
    ]
  }
}
