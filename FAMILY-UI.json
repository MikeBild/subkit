{
  "familyVersion": "2.3",
  "apiSchemaVersion": "operational-overview.v1",
  "scope": [
    "shell",
    "auth",
    "not-found",
    "fatal-error",
    "overview",
    "decisions",
    "collection",
    "detail",
    "form",
    "installation",
    "audit"
  ],
  "routes": {
    "overview": "/cockpit",
    "decisions": "/cockpit/decisions",
    "runs": "/cockpit/runs",
    "settings": "/cockpit/settings",
    "system": "/cockpit/system",
    "audit": "/cockpit/audit",
    "notifications": "/cockpit/notifications",
    "credentials": "/cockpit/credentials"
  },
  "navigation": {
    "firstItems": ["overview", "decisions"],
    "groups": ["work", "operations", "installation"],
    "labels": {
      "de": {
        "overview": "Übersicht",
        "decisions": "Entscheidungen",
        "work": "Arbeit",
        "operations": "Betrieb",
        "installation": "Installation",
        "runs": "Ausführungen",
        "settings": "Einstellungen",
        "system": "System",
        "audit": "Audit",
        "notifications": "Benachrichtigungen",
        "credentials": "Zugangsdaten"
      },
      "en": {
        "overview": "Overview",
        "decisions": "Decisions",
        "work": "Work",
        "operations": "Operations",
        "installation": "Installation",
        "runs": "Runs",
        "settings": "Settings",
        "system": "System",
        "audit": "Audit",
        "notifications": "Notifications",
        "credentials": "Credentials"
      }
    }
  },
  "geometry": {
    "sidebarExpandedPx": 256,
    "sidebarCollapsedPx": 48,
    "headerPx": 56,
    "gutterDesktopPx": 24,
    "gutterMobilePx": 16,
    "readingColumnPx": 780,
    "workingColumnPx": 1120,
    "workbenchColumnPx": 1280,
    "cardRadiusPx": 16,
    "cardGapPx": 16,
    "sectionGapPx": 24
  },
  "typography": {
    "pageTitle": "24px/32px 650",
    "sectionTitle": "16px/24px 600",
    "body": "14px/20px 400",
    "meta": "12px/16px 400"
  },
  "surfaces": {
    "auth": [
      "product-identity",
      "auth-heading",
      "provider-actions",
      "auth-meta"
    ],
    "not-found": ["failure-state", "failure-actions"],
    "fatal-error": ["failure-state", "failure-actions"],
    "overview": [
      "page-header",
      "operational-core",
      "product-metrics",
      "audit-meta"
    ],
    "decisions": [
      "page-header",
      "kind-filters",
      "queue-summary",
      "queue",
      "audit-meta"
    ],
    "collection": [
      "page-header",
      "collection-toolbar",
      "list-surface",
      "collection-meta",
      "pagination"
    ],
    "detail": [
      "breadcrumbs",
      "page-header",
      "facts",
      "content",
      "evidence",
      "audit-meta"
    ],
    "form": ["page-header", "fields", "actions"],
    "installation": ["page-header", "content"],
    "audit": ["page-header", "filters", "content", "pagination"]
  },
  "overview": {
    "titleId": "overview",
    "coreOrder": [
      "decisions.blocked",
      "decisions.failing",
      "decisions.overdue",
      "decisions.other",
      "operations.health",
      "data.freshness"
    ],
    "decisionBuckets": {
      "exclusiveOrder": ["blocked", "failing", "overdue", "other"],
      "fallbackDeadlineHours": 72,
      "drilldowns": {
        "blocked": "/cockpit/decisions?bucket=blocked",
        "failing": "/cockpit/decisions?bucket=failing",
        "overdue": "/cockpit/decisions?bucket=overdue",
        "other": "/cockpit/decisions?bucket=other"
      }
    },
    "health": {
      "states": ["healthy", "limited", "critical", "unknown"],
      "thresholds": { "healthyMin": 90, "limitedMin": 70, "criticalMin": 0 },
      "missingRequiredMeansUnknown": true,
      "redistributeMissingOptionalWeight": false,
      "drilldown": "worst-component",
      "componentDrilldowns": true,
      "maxCauses": 5
    },
    "coreDrilldownsNeverLeadTo": ["/cockpit/operations"],
    "freshness": {
      "value": "age-seconds-of-stalest-source",
      "staleSeverity": "critical",
      "drilldown": "stalest-source"
    },
    "refresh": {
      "recommendedSecondsMin": 10,
      "recommendedSecondsMax": 300,
      "pauseWhenDocumentHidden": true,
      "retainPreviousValues": true
    },
    "contentLimits": {
      "headerPurposeSentences": 1,
      "headerPurposeCharacters": 120,
      "tooltipSentences": 2,
      "tooltipCharacters": 240,
      "sectionDescriptionCharacters": 120,
      "objectLists": 0,
      "tables": 0,
      "feeds": 0,
      "incidentBanners": 0
    },
    "allowedVisualizations": [
      "kpi",
      "sparkline",
      "time-series",
      "progress",
      "segmented-distribution"
    ],
    "maxSegmentCategories": 5,
    "trendWindows": ["24h", "7d", "30d"]
  },
  "states": [
    "loading",
    "empty",
    "ready",
    "partial",
    "error",
    "forbidden",
    "stale",
    "unknown",
    "contract-mismatch"
  ],
  "domContract": {
    "surface": "data-family-surface",
    "slot": "data-family-slot",
    "state": "data-family-state",
    "kpiId": "data-family-kpi-id",
    "kpiValueState": "data-family-kpi-value-state",
    "kpiSeverity": "data-family-kpi-severity",
    "kpiKind": "data-family-kpi-kind",
    "kpiLink": "data-family-kpi-link",
    "kpiTooltip": "data-family-kpi-tooltip",
    "visualization": "data-family-visualization",
    "contractVersion": "data-family-contract-version",
    "decisionBucket": "data-family-decision-bucket",
    "decisionKind": "data-family-decision-kind",
    "decisionPriority": "data-family-decision-priority",
    "collectionId": "data-family-collection-id",
    "collectionTier": "data-family-collection-tier",
    "collectionCapability": "data-family-collection-capability",
    "collectionRow": "data-family-collection-row",
    "collectionMobileCard": "data-family-collection-mobile-card",
    "failureKind": "data-family-failure-kind",
    "authContract": "data-auth-contract",
    "authProduct": "data-auth-product",
    "authProvider": "data-auth-provider"
  },
  "auth": {
    "flow": "direct-provider-choice",
    "locale": ["de", "en"],
    "localeSource": "accept-language",
    "fallbackLocale": "en",
    "returnPath": "current-cockpit-path-and-query",
    "productIdentity": "real-cockpit-favicon-and-canonical-product-name",
    "providerOrder": ["sso", "api-key"],
    "footer": "{Product} · OAuth 2.1",
    "intermediateSpaSignIn": false
  },
  "failures": {
    "notFound": {
      "transport": "spa-shell-http-200",
      "shellRetained": true,
      "actions": ["overview"],
      "technicalDetails": false
    },
    "fatalError": {
      "shellActions": ["retry", "overview"],
      "bootstrapActions": ["retry"],
      "technicalDetails": false,
      "productionCrashRoute": false
    },
    "outsideCockpit": "existing-api-envelope"
  },
  "integration": {
    "rest": {
      "method": "GET",
      "path": "/v1/operational-overview",
      "p95MsMax": 500
    },
    "mcp": { "tool": "get_operational_overview", "readOnly": true },
    "metrics": {
      "path": "/metrics",
      "scope": "metrics:read",
      "servicePrincipalPerProduct": true,
      "authenticatedPrincipalRateLimitExempt": true,
      "highCardinalityLabelsAllowed": false
    }
  },
  "decisions": {
    "layout": "operational-workbench",
    "pageMeasure": "workbench",
    "order": ["blocked", "failing", "overdue", "other"],
    "filters": "kind-chips",
    "grouping": {
      "blocked": "Blockiert Arbeit",
      "failing": "Freigegeben, aber scheiternd",
      "overdue": "Liegt schon länger",
      "other": "Weitere Entscheidungen"
    },
    "rowSlots": [
      "decision-meta",
      "decision-title",
      "decision-effect",
      "decision-source",
      "decision-details",
      "decision-actions"
    ],
    "rowTitleCharactersMax": 120,
    "rowEffectCharactersMax": 160,
    "initialVisibleRowsMax": 25,
    "technicalDetailsCollapsed": true,
    "rawIdentifiersOnPrimarySurface": false,
    "rawErrorsOnPrimarySurface": false,
    "bucketQuery": ["blocked", "failing", "overdue", "other"],
    "details": "collapsed-by-default-expandable",
    "history": "audit-link-only"
  },
  "collections": {
    "pageMeasure": "workbench",
    "primary": {
      "requiredCapabilities": [
        "search",
        "relevant-filters",
        "sort",
        "column-visibility",
        "result-count",
        "pagination",
        "url-state",
        "responsive-cards",
        "loading-state",
        "empty-state",
        "error-state"
      ],
      "defaultPageSize": 25,
      "pageSizeOptions": [25, 50, 100],
      "stickyToolbar": false,
      "horizontalScrollDesktop": "last-resort"
    },
    "embedded": {
      "requiredCapabilities": [
        "sort-when-useful",
        "responsive-cards",
        "loading-state",
        "empty-state",
        "error-state"
      ],
      "pagination": "only-when-more-than-25",
      "columnVisibility": "not-required",
      "urlState": "not-required"
    },
    "rowHeightDesktopPx": { "minimum": 44, "maximum": 72 },
    "mobileCardGapPx": 12,
    "rawIdentifiers": "secondary-only",
    "technicalText": "collapsed-or-detail-only"
  },
  "visualLanguage": {
    "spacingGridPx": 4,
    "radius": "16px",
    "border": "1px",
    "shadow": "none",
    "accent": "family",
    "actions": {
      "primary": {
        "variant": "default",
        "backgroundToken": "primary",
        "foregroundToken": "primary-foreground",
        "hoverOpacityPercent": 90
      },
      "secondary": { "variant": "outline" },
      "tertiary": { "variant": "ghost" },
      "link": { "variant": "link", "foregroundToken": "accent" },
      "destructive": { "variant": "destructive", "foregroundToken": "destructive" }
    },
    "semanticColors": {
      "critical": "red",
      "urgent": "orange",
      "healthy": "green",
      "information": "blue",
      "unknown": "gray"
    },
    "motion": "functional-only",
    "focusRing": "2px"
  },
  "release": {
    "mode": "atomic-family",
    "mismatchToleranceMinutes": 15,
    "mismatchMutationPolicy": "disabled",
    "rollback": "whole-family"
  },
  "screenshots": {
    "viewports": ["desktop", "mobile"],
    "themes": ["light", "dark"],
    "consecutiveRuns": 2,
    "products": 6,
    "overviewImagesPerAcceptedRelease": 48,
    "updateDashboardAfterEveryAttempt": true
  }
}
