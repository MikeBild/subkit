    "detail",
    "form",
    "installation",
    "audit"
  ],
  "geometry": {
    "sidebarExpandedPx": 256,
    "sidebarCollapsedPx": 48,
    "headerPx": 56,
    "gutterDesktopPx": 24,
    "gutterMobilePx": 16,
    "readingColumnPx": 780,
    "workingColumnPx": 1120
  },
  "typography": {
    "pageTitle": "24px/32px 650",
    "sectionTitle": "16px/24px 600",
