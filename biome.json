{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!.stryker-tmp*",
      "!**/dist",
      "!**/docs",
      "!**/.github",
      "!**/.claude/worktrees",
      "!**/.claude/workflows",
      "!**/bun.lock",
      "!**/bun.lockb",
      "!packages/cli-core/src/engine-api/openapi.d.ts",
      "!packages/cli-core/src/engine-api/openapi.json",
      "!assets",
      "!apps/cockpit/src/app/release-notes.generated.ts",
      "!apps/cockpit/src/lib/service-icons.generated.ts",
      "!apps/cockpit/src/lib/service-icon-marks.generated.ts",
      "!apps/engine/src/http/llms/docs.json",
      "!apps/engine/src/http/cockpit-embedded.ts",
      "!packages/ui/contract/cockpit-ui.css",
      "!apps/engine/src/db/migrations/embedded.ts",
      "!apps/engine/eval/out",
      "!.agent-prime.json",
      "!apps/engine/src/sandboxes/quickjs/stdlib/helpers/*.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "none"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "**/_internal/*": "Imports from `_internal/` paths are package-private. The directory is the file-system enforcement of layering \u2014 only the same package's modules may reach in. Cross-package consumers must extend the package's public barrel (e.g. `./index.ts`) instead of reaching across this boundary."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/runner/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/cockpit/src/lib/preference-cookie.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/engine/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error"
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/atoms/**",
        "packages/ui/src/molecules/**",
        "packages/ui/src/organisms/**",
        "packages/ui/src/templates/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noRedundantRoles": "off",
            "noSvgWithoutTitle": "off",
            "useAriaPropsSupportedByRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
