{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/docs",
      "!**/.github",
      "!**/.claude/worktrees",
      "!**/.claude/workflows",
      "!**/bun.lock",
      "!**/bun.lockb",
      "!packages/cli-core/src/engine-api/openapi.d.ts",
      "!packages/cli-core/src/engine-api/openapi.json",
      "!assets/cockpit",
      "!apps/cockpit/src/api/schema.d.ts",
      "!apps/cockpit/src/app/release-notes.generated.ts",
      "!apps/cockpit/src/app/docs.generated.ts",
      "!apps/engine/src/http/llms/docs.json",
      "!apps/engine/src/http/cockpit-embedded.ts",
      "!contract/cockpit-ui.css",
      "!apps/engine/src/db/migrations/embedded.ts",
      "!apps/engine/eval/out",
      "!FAMILY-UI.json",
      "!OPERATIONAL-KPIS.json",
      "!OPERATIONAL-OVERVIEW.schema.json",
      "!.agent-prime.json",
      "!assets/clipper",
      "!apps/engine/src/sandboxes/quickjs/stdlib/helpers/*.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "none"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "**/_internal/*": "Imports from `_internal/` paths are package-private. The directory is the file-system enforcement of layering \u2014 only the same package's modules may reach in. Cross-package consumers must extend the package's public barrel (e.g. `./index.ts`) instead of reaching across this boundary."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/cockpit/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
