{
  "name": "@subkit/desktop",
  "productName": "SubKit",
  "version": "11.3.0",
  "private": true,
  "description": "SubKit Desktop: a hardened shell that loads the Cockpit of a SubKit server and brings its attention items to the tray and to native notifications.",
  "license": "Apache-2.0",
  "author": "Mike Bild",
  "homepage": "https://github.com/mikebild/subkit#readme",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts && electron .",
    "start": "electron .",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "bun run scripts/package.ts",
    "notices": "bun run scripts/notices.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "lucide-react": "1.76.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.38.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  }
}
