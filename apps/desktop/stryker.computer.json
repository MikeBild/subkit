{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "cd apps/desktop && bun test src/shared/local/computer-allowances.test.ts src/shared/local/owner-idle.test.ts src/shared/local/computer-redaction.test.ts src/shared/local/computer-commands.test.ts src/shared/local/computer-envelope.test.ts src/shared/local/computer-tree.test.ts src/shared/local/live-progress.test.ts src/shared/local/agent-desktop-bundle.test.ts src/shared/local/file-dialog.test.ts src/shared/device-vault-model.test.ts"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "mutate": [
    "apps/desktop/src/shared/local/computer-allowances.ts",
    "apps/desktop/src/shared/local/owner-idle.ts",
    "apps/desktop/src/shared/local/computer-redaction.ts",
    "apps/desktop/src/shared/local/computer-commands.ts",
    "apps/desktop/src/shared/local/computer-envelope.ts",
    "apps/desktop/src/shared/local/computer-tree.ts",
    "apps/desktop/src/shared/local/live-progress.ts",
    "apps/desktop/src/shared/local/agent-desktop-bundle.ts",
    "apps/desktop/src/shared/local/file-dialog.ts",
    "apps/desktop/src/shared/device-vault-model.ts"
  ],
  "ignorePatterns": [
    "/.artifacts",
    "/.stryker-tmp*",
    "/.stryker-tmp-root",
    "/.stryker-tmp-tests",
    "/.stryker-tmp-redaction",
    "/.stryker-tmp-shared",
    "/.stryker-tmp-workflow-automation",
    "/.tmp",
    "/.devtools",
    "/.superdesign",
    "/.claude",
    "/.sk",
    "/dist",
    "/docs",
    "/benchmarks",
    "/reports",
    "/coverage",
    "/assets/cockpit",
    "/assets/clipper",
    "/apps/clipper",
    "/apps/engine/assets/embeddings",
    "/apps/engine/eval/out",
    "/subkit.config.json",
    "/creds.txt",
    "apps/engine/.devtools",
    "*.log",
    "*-key.txt",
    ".env*",
    "*.pem",
    "*.key",
    "apps/engine/subkit.config.json"
  ],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/desktop-computer.json" },
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
