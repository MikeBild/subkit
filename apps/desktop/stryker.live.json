{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test packages/shared/src/device/actions.test.ts apps/cockpit/src/features/operations/device-steps-model.test.ts && cd apps/desktop && bun test src/shared/local/live-view-model.test.ts src/shared/local/permission-model.test.ts"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "mutate": [
    "apps/desktop/src/shared/local/live-view-model.ts",
    "apps/desktop/src/shared/local/permission-model.ts",
    "packages/shared/src/device/actions.ts",
    "apps/cockpit/src/features/operations/device-steps-model.ts"
  ],
  "ignorePatterns": [
    "/.artifacts",
    "/.stryker-tmp*",
    "/.stryker-tmp-root",
    "/.stryker-tmp-tests",
    "/.stryker-tmp-redaction",
    "/.stryker-tmp-shared",
    "/.stryker-tmp-workflow-automation",
    "/.tmp",
    "/.devtools",
    "/.superdesign",
    "/.claude",
    "/.sk",
    "/dist",
    "/docs",
    "/benchmarks",
    "/reports",
    "/coverage",
    "/assets/cockpit",
    "/assets/clipper",
    "/apps/clipper",
    "/apps/engine/assets/embeddings",
    "/apps/engine/eval/out",
    "/subkit.config.json",
    "/creds.txt",
    "apps/engine/.devtools",
    "*.log",
    "*-key.txt",
    ".env*",
    "*.pem",
    "*.key",
    "apps/engine/subkit.config.json"
  ],
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/desktop-live.json" },
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
