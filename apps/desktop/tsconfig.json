{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@ui/*": ["../../packages/ui/src/*"],
