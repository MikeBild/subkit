  "tool.descriptor.analyze": "{\"name\":\"analyze_knowledge_source\",\"description\":\"Generate a description and topical tags for a persisted Knowledge Source by reading its first chunks. Use this to make a legacy source (uploaded without a description, or with no tags) self-describing and routable. Tags are replaced with a freshly generated set; the description is only overwritten when force=true.\",\"category\":\"tenant_write\",\"permission\":{\"action\":\"knowledge:write\",\"resourceType\":\"knowledge\",\"resourceIdArg\":\"id\"},\"use_case\":\"Use when the user asks to summarise, describe, tag, or 're-analyze' an existing Knowledge Source, or when list_knowledge_sources shows a source with a null description / empty tags. Pass force=true to regenerate an existing description.\",\"important_notes\":[\"Never renames the source — analysis enriches description + tags only.\",\"tags are a deduped replacement set (3-8 short topical tags).\",\"description is overwritten only when currently empty or force=true.\",\"Counts against the tenant LLM budget; one model call per analyze.\"],\"input\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"format\":\"uuid\",\"pattern\":\"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<uuid-11>|<uuid-12>)$\"},\"force\":{\"type\":\"boolean\"}},\"required\":[\"id\"],\"additionalProperties\":false}}",
  "tool.descriptor.get": "{\"name\":\"get_knowledge_source\",\"description\":\"Fetch a single knowledge source by id.\",\"category\":\"tenant_read\",\"permission\":{\"action\":\"knowledge:read\",\"resourceType\":\"knowledge\",\"resourceIdArg\":\"id\"},\"input\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"format\":\"uuid\",\"pattern\":\"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<uuid-11>|<uuid-12>)$\"}},\"required\":[\"id\"],\"additionalProperties\":false}}",
  "tool.descriptor.list": "{\"name\":\"list_knowledge_sources\",\"description\":\"List the tenant's Knowledge Sources with what each covers (`description`), its catalog block (`category`, also a filter) and its tags. Use this first to decide which source covers a topic, then call search_knowledge to pull the relevant chunks.\",\"category\":\"tenant_read\",\"permission\":{\"action\":\"knowledge:read\",\"resourceType\":\"knowledge\"},\"input\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"category\":{\"description\":\"Only sources in this catalog block (see `category` on each source).\",\"type\":\"string\"}},\"additionalProperties\":false}}",
  "tool.descriptor.update": "{\"name\":\"update_knowledge_source\",\"description\":\"Patch a persisted knowledge source — rename, edit its description/tags, retarget the workflow scope, change status, or change refresh cadence.\",\"category\":\"tenant_write\",\"permission\":{\"action\":\"knowledge:write\",\"resourceType\":\"knowledge\",\"resourceIdArg\":\"id\"},\"use_case\":\"Use when the user asks to rename a knowledge source, set its description or tags, archive it (status='inactive'), repoint it to a different workflow scope, or change its refresh cadence. To auto-generate a description/tags from the content instead of dictating them, use analyze_knowledge_source. Send only the fields that should change.\",\"important_notes\":[\"At least one patch field is required.\",\"Switching scope to 'workflow' requires workflow_id to be set (either in this patch or already on the row).\",\"Audits as knowledge_source.updated with full before/after snapshots — never overrides ingested chunk history.\"],\"input\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"format\":\"uuid\",\"pattern\":\"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<uuid-11>|<uuid-12>)$\"},\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},\"description\":{\"type\":\"string\",\"maxLength\":2000},\"tags\":{\"maxItems\":20,\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":40}},\"scope\":{\"type\":\"string\",\"enum\":[\"global\",\"workflow\"]},\"workflow_id\":{\"anyOf\":[{\"type\":\"string\",\"format\":\"uuid\",\"pattern\":\"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|<uuid-11>|<uuid-12>)$\"},{\"type\":\"null\"}]},\"status\":{\"type\":\"string\",\"enum\":[\"active\",\"inactive\"]},\"refresh_strategy\":{\"type\":\"string\",\"enum\":[\"manual\",\"scheduled\"]},\"refresh_cron\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"id\"],\"additionalProperties\":false}}",
  "tool.update.actor": "{\"ok\":true,\"data\":{\"updated\":true,\"knowledge_source\":{\"id\":\"<plain>\",\"name\":\"plain-notes\",\"tags\":[\"notes\"],\"scope\":\"global\",\"status\":\"active\"},\"audit_log_id\":\"<uuid-15>\"}}",
  "tool.update.missing": "{\"ok\":false,\"data\":{\"error\":\"knowledge_source_not_found\",\"id\":\"0f0f0f0f-0f0f-4f0f-8f0f-0f0f0f0f0f0f\"}}",
  "tool.update.principal": "{\"ok\":true,\"data\":{\"updated\":true,\"knowledge_source\":{\"id\":\"<runbook>\",\"name\":\"Deploy runbook\",\"tags\":[\"deploy\",\"release\"],\"scope\":\"global\",\"status\":\"active\"},\"audit_log_id\":\"<uuid-14>\"}}",
  "tool.update.scope-without-workflow": "{\"ok\":false,\"data\":{\"error\":\"scope_workflow_requires_workflow_id\",\"message\":\"workflow_id is required when scope is 'workflow'\"}}",
  "tool.update.system": "{\"ok\":true,\"data\":{\"updated\":true,\"knowledge_source\":{\"id\":\"<runbook>\",\"name\":\"Deploy runbook\",\"tags\":[\"deploy\",\"release\"],\"scope\":\"global\",\"status\":\"active\"},\"audit_log_id\":\"<uuid-13>\"}}",
  "tool.update.unknown-workflow": "{\"ok\":false,\"error\":\"update_failed\"}"
