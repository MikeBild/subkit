    "headers": {
      "x-amz-target": "AmazonSQS.SendMessage",
      "content-type": "application/x-amz-json-1.0"
    },
    "body": {
      "QueueUrl": "https://sqs.us-east-1.amazonaws.com/000000000000/synthetic-queue",
      "MessageBody": "synthetic message"
    }
