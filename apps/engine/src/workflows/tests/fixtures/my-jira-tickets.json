{
  "name": "My Jira Tickets",
  "slug": "my-jira-tickets",
  "steps": [
    {
      "id": "fetch_my_tickets",
      "kind": "request",
      "path": "/rest/api/3/search/jql",
      "query": {
        "jql": "assignee = currentUser() ORDER BY updated DESC",
        "fields": "summary,status,priority,issuetype,project,updated,created"
      },
      "method": "GET",
      "on_error": "fail",
      "connector_id": "aaaaaaaa-aaaa-4aaa-8aaa-000000000001"
    },
    {
      "id": "format_output",
      "kind": "transform",
      "language": "jsonata",
      "on_error": "fail",
      "expression": "$scope.fetch_my_tickets.data.issues.{ \"key\": key, \"summary\": fields.summary, \"status\": fields.status.name, \"priority\": fields.priority.name, \"updated\": fields.updated }"
    }
  ]
}
