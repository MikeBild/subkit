{
  "name": "authoring-guidance-reachable",
  "description": "Convention, consistency and contradiction guidance stays reachable in the authoring phase that needs it. Each phase replays the events the conversation loop sees (user turn, tool calls, diagnosis codes) against the shipped skill seeds and their activates_when rules; a rule passes only when a skill that actually loads in that phase carries its fragments. Text that exists in some skill nobody loads does not count. Two controls run on every pass: moving a rule's paragraphs into a skill that never activates must make the rule fail, and moving them into a skill that activates on the phase's tool must keep it green. A phase split of the authoring skill passes as long as every rule stays reachable; a reworded rule needs its fragments updated here on purpose.",
  "flow": "converse",
  "failure_class": "authoring skill split drops convention, consistency or contradiction guidance from the phase that needs it",
  "depends_on": ["skill_autoload"],
  "input": {
    "phases": [
      {
        "id": "build",
        "events": [
          {
            "user_turn": "Erstelle einen neuen Workflow, der jeden Montag den Wochenbericht per Mail an das Team schickt",
            "first_turn": true
          },
          {
            "tool": "author_workflow",
            "input": {
              "goal": "Send the weekly status report by mail every Monday.",
              "connector_slugs": ["gmail-team"]
            }
          }
        ]
      },
      {
        "id": "patch",
        "events": [
          {
            "tool": "edit_workflow_patch",
            "input": {
              "patches": [
                {
                  "op": "add",
                  "path": "/steps/-",
                  "value": {
                    "id": "shape",
                    "kind": "transform",
                    "language": "javascript",
                    "expression": "return input.scope.list_items.data;"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "delivery_review",
        "events": [
          { "tool": "review_workflow_automation", "input": {} },
          { "diagnoses": ["header_not_allowed", "report_delivery_contradicted"] }
        ]
      }
    ],
    "rules": [
      {
        "id": "request_shape_flat",
        "category": "convention",
        "phases": ["build", "patch"],
        "fragments": ["Do not wrap them in `config`"]
      },
      {
        "id": "requested_identity",
        "category": "convention",
        "phases": ["build"],
        "fragments": ["Pass an explicitly requested workflow `name` and `slug`"]
      },
      {
        "id": "outcome_labels",
        "category": "convention",
        "phases": ["build", "delivery_review"],
        "fragments": ["User-facing questions and labels describe outcomes"]
      },
      {
        "id": "editor_choice",
        "category": "convention",
        "phases": ["build", "patch"],
        "fragments": ["`author_workflow` vs `edit_workflow_patch`"]
      },
      {
        "id": "patch_by_step_id",
        "category": "convention",
        "phases": ["patch"],
        "fragments": ["step_patches", "Never mix the two forms"]
      },
      {
        "id": "preserve_schedules_destinations",
        "category": "consistency",
        "phases": ["patch", "delivery_review"],
        "fragments": ["Preserve existing schedules and destinations"]
      },
      {
        "id": "preserve_storage_prefix",
        "category": "consistency",
        "phases": ["delivery_review"],
        "fragments": [
          "Preserve the full existing storage key prefix",
          "never broaden to an entire bucket"
        ]
      },
      {
        "id": "caller_identity",
        "category": "consistency",
        "phases": ["build", "patch"],
        "fragments": ["Never use `${$caller.principalId}`, `${input.owner_id}`"]
      },
      {
        "id": "five_failures",
        "category": "consistency",
        "phases": ["build", "patch"],
        "fragments": ["Five consecutive failures"]
      },
      {
        "id": "no_fabricated_destination",
        "category": "contradiction",
        "phases": ["build"],
        "fragments": ["never fabricate placeholders like `test@example.com`"]
      },
      {
        "id": "reply_to_outside_review",
        "category": "contradiction",
        "phases": ["build", "delivery_review"],
        "fragments": ["Cc, Bcc, Reply-To, custom headers and attachments stay outside the review"]
      },
      {
        "id": "one_grounded_question",
        "category": "contradiction",
        "phases": ["build", "patch", "delivery_review"],
        "fragments": ["one short question, clear effects, and a grounded recommendation"]
      },
      {
        "id": "ground_before_author",
        "category": "contradiction",
        "phases": ["build"],
        "fragments": ["`search_docs` / `search_knowledge`"]
      }
    ],
    "controls": {
      "unreachable_activation": [{ "kind": "diagnosis", "codes": ["guidance_never_emitted"] }]
    }
  }
}
