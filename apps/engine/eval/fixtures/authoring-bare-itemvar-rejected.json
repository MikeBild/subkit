{
  "name": "authoring-bare-itemvar-rejected",
  "description": "item_var retirement: a generated/built definition that addresses the loop item by a bare name in a loop-body JSONata slot (branch.when) is rejected with a `$item` did_you_mean, and declaring `item_var` itself is rejected as a retired field. (Transforms are JavaScript-only and are not JSONata-linted, so the bare-item lint is exercised through the still-linted branch.when slot.)",
  "flow": "converse",
  "input": {
    "bare_item_workflow": {
      "steps": [
        {
          "id": "fetch",
          "kind": "request",
          "method": "GET",
          "url": "https://api.example.com/projects"
        },
        { "id": "each", "kind": "loop", "over": "$scope.fetch.data.projects", "body": ["gate"] },
        {
          "id": "gate",
          "kind": "branch",
          "when": "item.active = true"
        }
      ]
    },
    "legacy_item_var_workflow": {
      "steps": [
        {
          "id": "fetch",
          "kind": "request",
          "method": "GET",
          "url": "https://api.example.com/projects"
        },
        {
          "id": "each",
          "kind": "loop",
          "over": "$scope.fetch.data.projects",
          "item_var": "project",
          "body": ["gate"]
        },
        {
          "id": "gate",
          "kind": "branch",
          "when": "project.active = true"
        }
      ]
    },
    "expect": {
      "bare_error_code": "bare_iteration_identifier",
      "retired_error_code": "item_var_retired",
      "did_you_mean_contains": "$item"
    }
  }
}
