    },
    "files": {
      "backend": "local",
      "dir": "",
      "bucket": ""
    },
    "offload": {
      "bucket": "",
      "region": "",
      "access_key": "",
      "secret_key": "",
      "endpoint": "",
      "key_prefix": "offload"
    }
  },
  "observability": {
    "langfuse": {
      "host": "",
      "public_key": "",
      "secret_key": ""
    },
    "otlp": {
      "endpoint": "",
      "service_name": "subkit"
    },
    "analytics": {
      "enabled": false,
      "endpoint": "",
      "api_key": "",
      "project": ""
    },
    "usage": {
      "enabled": false,
      "hmac_secret": "",
      "retention_days": 90
    },
    "deployment_environment": "development",
    "field_truncation_chars": 2048,
    "predictive": {
      "pool_saturation_pct": 80,
      "dlq_critical_depth": 5,
      "transient_retry_rate": 1,
      "memory_cap_fraction": 0.9,
      "connector_unhealthy_pct": 80,
      "llm_fallback_pct": 80
    }
  },
  "egress": {
    "mode": null,
    "provider_hosts_extra": []
  },
  "mcp": {
    "api_key": "",
    "read_only": false,
    "servers": [],
    "client": {
      "per_server_manifest_byte_cap": 30000,
      "remote_tool_call_timeout_ms": 30000
    }
  },
  "errors": {
    "ring_size": 100
  },
  "spec": {
    "allow_private_fetch": false
  },
  "queue": {
    "concurrency": 8
  },
  "tokens": {
    "monthly_budget": 0
  },
  "sandbox": {
    "memory_bytes": 134217728,
    "tick_budget": 10000000,
    "wall_ms": 30000,
    "stack_bytes": 2097152,
    "transform_wall_ms": 60000
  },
  "repl": {
    "permissionMode": "ask",
    "portalTokenTtlMin": 15
  },
  "ui": {
    "theme": "auto",
    "personality": "balanced",
    "title": {
      "format": "session-id"
    },
    "statusline": {
      "format": "compact"
    }
  },
  "notifications": {
    "push": {
      "enabled": false,
      "thresholdSec": 30,
      "quietHoursStart": "",
      "quietHoursEnd": ""
    }
  },
  "connectors": {
    "web_scraper": {
      "runtime": {
        "respect_robots": true,
        "user_agent": "sk-web-scraper/1.0 (+https://subkit.io/bot)",
        "max_pages": 1000,
        "max_chars_readability": 100000,
        "max_chars_markdown": 100000,
        "default_wait_ms": 0
      },
      "robots_cache": {
        "ttl_ms": 3600000,
        "max_entries": 2000
      },
      "authoring": {
        "yellow_sitemap_threshold": 10000,
        "red_sitemap_threshold": 100000,
        "extract_too_large_yellow_pct": 30
      },
      "optimization": {
        "scan_cron": "0 3 * * *",
        "sample_size": 10,
        "trivial_markdown_bytes": 512,
        "min_runs_before_proposing": 3
      }
    },
    "http": {
      "max_response_bytes": 104857600
    }
  },
  "tenants": {}
}
