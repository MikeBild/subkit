{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cockpit-family:operational-overview:v1",
  "title": "Cockpit family operational overview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "product",
    "generated_at",
    "recommended_refresh_seconds",
    "snapshot_state",
    "core",
    "sections",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "operational-overview.v1"
    },
    "contract_version": {
      "const": "2.3"
    },
    "product": {
      "enum": [
        "workkit",
        "subkit",
        "wikikit",
        "contentkit",
        "codekit",
        "watchkit"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommended_refresh_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 300
    },
    "snapshot_state": {
      "enum": [
        "ready",
        "partial",
        "forbidden",
        "contract-mismatch"
      ]
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked",
        "failing",
        "overdue",
        "other_decisions",
        "health",
        "data_freshness"
      ],
      "properties": {
        "blocked": {
          "$ref": "#/$defs/metric"
        },
        "failing": {
          "$ref": "#/$defs/metric"
        },
        "overdue": {
          "$ref": "#/$defs/metric"
        },
        "other_decisions": {
          "$ref": "#/$defs/metric"
        },
        "health": {
          "$ref": "#/$defs/healthMetric"
        },
        "data_freshness": {
          "$ref": "#/$defs/freshnessMetric"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contract_version",
        "snapshot_generated_at"
      ],
      "properties": {
        "path": {
          "const": "/cockpit/audit"
        },
        "contract_version": {
          "const": "2.3"
        },
        "snapshot_generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "drilldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "label_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/cockpit(?:/|$|\\?)"
        },
        "label_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "delta",
        "direction"
      ],
      "properties": {
        "window": {
          "enum": [
            "24h",
            "7d",
            "30d"
          ]
        },
        "delta": {
          "type": "number"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ]
        }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(workkit|subkit|wikikit|contentkit|codekit|watchkit)_operational_[a-z0-9_]+$"
        },
        "type": {
          "enum": [
            "gauge",
            "counter"
          ]
        }
      }
    },
    "baseMetric": {
      "type": "object",
      "required": [
        "id",
        "label",
        "definition",
        "relevance",
        "kind",
        "value",
        "value_state",
        "unit",
        "severity",
        "required",
        "source_updated_at",
        "expected_interval_seconds",
        "stale_after_seconds",
        "drilldown",
        "prometheus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "relevance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "duration",
            "score",
            "currency",
            "state"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_state": {
          "enum": [
            "observed",
            "zero",
            "missing",
            "stale",
            "forbidden"
          ]
        },
        "unit": {
          "enum": [
            "count",
            "ratio",
            "seconds",
            "bytes",
            "eur",
            "state"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "urgent",
            "healthy",
            "information",
            "unknown"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "source_updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expected_interval_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stale_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "drilldown": {
          "$ref": "#/$defs/drilldown"
        },
        "prometheus": {
          "$ref": "#/$defs/prometheus"
        },
        "trend": {
          "$ref": "#/$defs/trend"
        }
      }
    },
    "metric": {
      "allOf": [
        {
          "$ref": "#/$defs/baseMetric"
        }
      ],
      "unevaluatedProperties": false
    },
    "healthComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "raw_value",
        "unit",
        "normalized_score",
        "weight",
        "contribution",
        "freshness",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "raw_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "normalized_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contribution": {
          "type": [
            "number",
            "null"
          ]
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "missing",
            "forbidden"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "drilldown": {
          "$ref": "#/$defs/drilldown"
        }
      }
    },
    "healthCause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "drilldown"
      ],
      "properties": {
        "kind": {
          "enum": [
            "failing_group",
            "held_schedule",
            "connector"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "The producing engine's own sentence. A UI composes its words from subject and reason where they are present."
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "name"],
          "properties": {
            "kind": {
              "enum": ["workflow", "connector"]
            },
            "id": {
              "type": ["string", "null"]
            },
            "name": {
              "type": ["string", "null"]
            }
          }
        },
        "reason": {
          "enum": [
            "held_for_review",
            "failing",
            "needs_reauth",
            "needs_update",
            "degraded",
            "unhealthy"
          ]
        },
        "detail": {
          "type": ["string", "null"],
          "description": "Residual engine free text, shown only as the engine's wording."
        },
        "cause_class": {
          "type": ["string", "null"]
        },
        "drilldown": {
          "$ref": "#/$defs/drilldown"
        }
      }
    },
    "healthMetric": {
      "allOf": [
        {
          "$ref": "#/$defs/baseMetric"
        },
        {
          "type": "object",
          "required": [
            "state",
            "components"
          ],
          "properties": {
            "state": {
              "enum": [
                "healthy",
                "limited",
                "critical",
                "unknown"
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/healthComponent"
              }
            },
            "causes": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/healthCause"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "freshnessSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "updated_at",
        "expected_interval_seconds",
        "stale_after_seconds",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expected_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "fresh",
            "stale",
            "missing",
            "forbidden"
          ]
        },
        "drilldown": {
          "$ref": "#/$defs/drilldown"
        }
      }
    },
    "freshnessMetric": {
      "allOf": [
        {
          "$ref": "#/$defs/baseMetric"
        },
        {
          "type": "object",
          "required": [
            "state",
            "sources"
          ],
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale",
                "missing",
                "forbidden"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/freshnessSource"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "visualization",
        "metrics",
        "drilldown"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visualization": {
          "enum": [
            "kpi",
            "sparkline",
            "time-series",
            "progress",
            "segmented-distribution"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "drilldown": {
          "$ref": "#/$defs/drilldown"
        }
      }
    }
  }
}
