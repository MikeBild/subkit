{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun run apps/engine/scripts/run-core-tests.ts"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "apps/engine/src/**/core.ts",
    "apps/engine/src/**/core/**/*.ts",
    "apps/cockpit/src/pages/core/attention-navigation.ts",
    "apps/cockpit/src/lib/core/authority-view.ts",
    "apps/cockpit/src/pages/core/audit-evidence.ts",
    "apps/cockpit/src/pages/core/attention-projection.ts",
    "apps/cockpit/src/pages/core/run-outcome.ts",
    "apps/cockpit/src/pages/core/decision-queue.ts",
    "apps/cockpit/src/pages/core/decision-facts.ts",
    "packages/shared/src/workflow-review-environment.ts",
    "packages/shared/src/ux-gating.ts",
    "packages/shared/src/suggest-next-reasons.ts",
    "packages/shared/src/conversation-reference.ts",
    "packages/shared/src/connector-operation-error.ts",
    "packages/shared/src/audit-source.ts",
    "packages/cli-core/src/message-parts.ts",
    "packages/cli-core/src/turn-event-model.ts",
    "packages/cli-core/src/errors-facts.ts",
    "apps/sk/src/commands/workflow-save-model.ts",
    "apps/sk/src/commands/connector-save-model.ts",
    "apps/cockpit/src/lib/core/identifier.ts",
    "apps/cockpit/src/lib/core/automation-presentation.ts",
    "apps/cockpit/src/lib/core/authority-decision.ts",
    "apps/cockpit/src/pages/core/audit-filter.ts",
    "apps/cockpit/src/pages/core/runs-filter.ts",
    "apps/cockpit/src/pages/audit-filter-state.ts",
    "apps/cockpit/src/pages/audit-labels.ts",
    "apps/cockpit/src/pages/knowledge-source-request.ts",
    "apps/engine/src/workflows/draft-projection.ts",
    "apps/sk/src/domain/agent/agent-file.ts",
    "apps/sk/src/commands/workflow-file-model.ts",
    "packages/cli-core/src/errors-classification.ts",
    "packages/cli-core/src/format-render.ts",
    "packages/shared/src/approval-choice.ts",
    "packages/shared/src/elicitation-constants.ts",
    "packages/shared/src/graphql-url.ts",
    "packages/shared/src/invoke-snippet.ts",
    "packages/shared/src/llms-index.ts",
    "packages/shared/src/redaction.ts",
    "packages/shared/src/side-effects.ts",
    "packages/shared/src/validation-result.ts",
    "packages/shared/src/workflow-automation.ts",
    "packages/shared/src/workflow-operating-status.ts",
    "packages/shared/src/workflow-review-target.ts",
    "packages/shared/src/workflow-strip.ts",
    "!**/*.test.ts",
    "!**/tests/**",
    "!**/__tests__/**",
    "!**/*.d.ts"
  ],
  "ignorePatterns": [
    "/.artifacts",
    "/.stryker-tmp*",
    "/.stryker-tmp-root",
    "/.stryker-tmp-tests",
    "/.stryker-tmp-redaction",
    "/.stryker-tmp-shared",
    "/.stryker-tmp-workflow-automation",
    "/.tmp",
    "/.devtools",
    "/.superdesign",
    "/.claude",
    "/.sk",
    "/dist",
    "/docs",
    "/benchmarks",
    "/reports",
    "/coverage",
    "/assets",
    "/apps/clipper",
    "/apps/engine/assets/embeddings",
    "/apps/engine/eval/out",
    "/subkit.config.json",
    "/creds.txt",
    "apps/engine/.devtools",
    "*.log",
    "*-key.txt",
    ".env*",
    "*.pem",
    "*.key",
    "apps/engine/subkit.config.json"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "incremental": false,
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 8,
  "timeoutMS": 30000
}
