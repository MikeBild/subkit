node_modules/
dist/
*.log
.DS_Store
# Local dev-tool run/step recorder — a multi-MB artifact rewritten on every
# engine boot; never a committed source (was accidentally tracked once).
apps/engine/.devtools/
# Review scaffolding — benchmarks are temporary proof harnesses, not
# committed; permanent regression coverage lives in unit tests.
benchmarks/
.env
.env.local
.env.*.local
.env.deploy
coverage/
.bun/
# bun.lock is committed — Docker multi-stage build and CI's
# `bun install --frozen-lockfile` both require it. bun.lockb (legacy
# binary format) remains ignored.
bun.lockb
.turbo/
tsconfig.tsbuildinfo
# Claude Code agent state (agents, hooks, skills, commands, settings) lives on
# disk locally but is intentionally not version-controlled.
/.claude/

# Eval pipeline artifacts — regenerated by `bun run eval`; tracking them
# pollutes blame/diff.
apps/engine/eval/out/

# Binary staging for the engine docker image — populated by
# scripts/release/embed-binaries.sh before `docker build`. The dir
# itself is committed (via .gitkeep) so the Dockerfile's COPY always
# resolves; the per-platform binaries + SHA256SUMS are gitignored.
docker/binaries/*
!docker/binaries/.gitkeep

# v3.5+ runtime config file. Auto-generated on first boot in any dev
# directory the engine runs in (it's the engine's persisted runtime
# state, not source code). The committed `subkit.config.example.json`
# is the canonical operator template.
subkit.config.json

# Docker-image E2E (tests/docker) runtime artifacts — sk profile homes the
# harness writes per run + engine log snapshots collected on failure.
.docker-sk-home/
.docker-repl-home/
engine-docker*.log


# Embedded-embedding assets — MiniLM model/tokenizer + onnxruntime-web WASM
# fetched by scripts/fetch-embedding-assets.ts and inlined into the compiled
# engine binary. Too large to commit; reproduced from a pinned model id.
apps/engine/assets/embeddings/
