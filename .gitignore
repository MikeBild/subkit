node_modules/
dist/
*.log
.DS_Store
.env
.env.local
.env.*.local
.env.deploy
coverage/
.bun/
# bun.lock is committed — Docker multi-stage build and CI's
# `bun install --frozen-lockfile` both require it. bun.lockb (legacy
# binary format) remains ignored.
bun.lockb
.turbo/
tsconfig.tsbuildinfo
firebase/firebase-sdk-config.json
firebase/.firebase/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Eval pipeline artifacts — regenerated by `bun run eval`; tracking them
# pollutes blame/diff.
apps/engine/eval/out/

# Binary staging for the engine docker image — populated by
# scripts/release/embed-binaries.sh before `docker build`. The dir
# itself is committed (via .gitkeep) so the Dockerfile's COPY always
# resolves; the per-platform binaries + SHA256SUMS are gitignored.
docker/binaries/*
!docker/binaries/.gitkeep

