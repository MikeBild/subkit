#!/usr/bin/env bash
# Pre-push gate. There is no CI; this hook and `bun run verify` before a release tag are the gate.

set -e

echo "[pre-push] lint + typecheck + determinism + invariants + drift + commit messages + secrets + build"

echo "[pre-push] 1/8 biome (lint)"
bun run lint

echo "[pre-push] 2/8 tsc (typecheck)"
bun run typecheck

echo "[pre-push] 3/8 determinism lint (no Date.now / randomBytes / Math.random in *.test.ts)"
# CI's build job runs `scripts/check-determinism.ts` and fails on
# `errors > 0`. Running it locally here means a `randomBytes(...)`
# inside a `.test.ts` (or `Math.random()`, etc.) is caught before
# push instead of after the CI run. Each error in this lint always
# fails CI; warnings do not.
bun run test:determinism

echo "[pre-push] 4/8 audit:invariants (route layering, file size, tenant filter, etc.)"
# CI's invariants job runs the same script. The most common local-vs-
# CI drift caught here is `route_layering` (a route file importing a
# subsystem internal instead of the subsystem's index.ts barrel).
# Skip pr_template inside the hook (it requires PR_BODY which only
# CI sets); audit-invariants.ts auto-skips it without env.
bun run audit:invariants

echo "[pre-push] 5/8 generated-artifact drift (regenerate; fail on diff)"
# EVERY generated page/client that CI's "Docs drift" step guards, mirrored
# here so a stale artifact can't reach main and break CI. Without the full
# set, adding a CLI command / slash command / route / setting lands with its
# generated doc stale and the round-trip repeats — the exact v1.5.0 miss,
# where a new `sk chat` command left cli-reference.md / slash-commands.md /
# llms-full.txt stale (pre-push only checked openapi-drift then). Keep this
# list in sync with the `check:*-drift` chain in package.json `verify`.
bun run check:openapi-drift
bun run check:settings-doc-drift
bun run check:slash-doc-drift
bun run check:sk-settings-doc-drift
bun run check:cli-reference-drift
bun run check:config-example-drift
bun run check:embedded-drift
bun run check:llms-txt-drift
bun run check:docs-refs

echo "[pre-push] 6/8 commit-message gate (each new commit on this push)"
# Walks the commits being pushed via the pre-push stdin range and
# validates each header against scripts/check-commit-message.sh
# (header-max-length=100, conventional type-enum, subject-case).
# Pure bash — no commitlint dependency at push time.
zero=$(git hash-object --stdin < /dev/null | tr 'a-f0-9' '0')
push_refs=$(mktemp)
trap 'rm -f "$push_refs"' EXIT
cat > "$push_refs"
msg_failed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && continue
  if ! bash scripts/check-commit-message.sh --range "$base..$local_sha"; then
    msg_failed=1
  fi
done < "$push_refs"
if [ "$msg_failed" -ne 0 ]; then
  echo "[pre-push] commit-message gate failed; fix the messages before pushing" >&2
  exit 1
fi

echo "[pre-push] 7/8 gitleaks (secrets in the pushed commits)"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$remote_sha"
  else
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  fi
  if [ -z "$base" ]; then
    range="$local_sha"
  elif [ "$base" = "$local_sha" ]; then
    continue
  else
    range="$base..$local_sha"
  fi
  gitleaks git . --config .gitleaks.toml --redact --no-banner --log-opts="$range"
done < "$push_refs"

echo "[pre-push] 8/8 build all binaries"
bun run build:sk
bun run build:engine

echo "[pre-push] all green — run \`bun run verify\` before tagging a release"
