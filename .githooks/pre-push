#!/usr/bin/env bash

set -e

echo "[pre-push] lint + typecheck + determinism + invariants + drift + commit messages + secrets + build"

echo "[pre-push] 1/8 biome (lint)"
bun run lint

echo "[pre-push] 2/8 tsc (typecheck)"
bun run typecheck

echo "[pre-push] 3/8 determinism lint (no Date.now / randomBytes / Math.random in *.test.ts)"
bun run test:determinism

echo "[pre-push] 4/8 audit:invariants (route layering, file size, tenant filter, etc.)"
bun run audit:invariants

echo "[pre-push] 5/8 generated-artifact drift (regenerate; fail on diff)"
bun run check:openapi-drift
bun run check:config-example-drift
bun run check:embedded-drift
bun run check:llms-txt-drift

echo "[pre-push] 6/8 commit-message gate (each new commit on this push)"
zero=$(git hash-object --stdin < /dev/null | tr 'a-f0-9' '0')
push_refs=$(mktemp)
trap 'rm -f "$push_refs"' EXIT
cat > "$push_refs"
msg_failed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && continue
  if ! bash scripts/check-commit-message.sh --range "$base..$local_sha"; then
    msg_failed=1
  fi
done < "$push_refs"
if [ "$msg_failed" -ne 0 ]; then
  echo "[pre-push] commit-message gate failed; fix the messages before pushing" >&2
  exit 1
fi

echo "[pre-push] 7/8 gitleaks (secrets in the pushed commits)"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$remote_sha"
  else
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  fi
  if [ -z "$base" ]; then
    range="$local_sha"
  elif [ "$base" = "$local_sha" ]; then
    continue
  else
    range="$base..$local_sha"
  fi
  gitleaks git . --config .gitleaks.toml --redact --no-banner --log-opts="$range"
done < "$push_refs"

echo "[pre-push] 8/8 build all binaries"
bun run build:sk
bun run build:engine

echo "[pre-push] all green — run \`bun run verify\` before tagging a release"
