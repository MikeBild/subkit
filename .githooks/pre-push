#!/usr/bin/env bash
# Pre-push gate — fast subset of the CI quality gate.
#
# Pre-fix the hook also ran the full unit/integration suite (`bun test
# apps/engine/src/conversations/ apps/engine/src/execution/tests/
# apps/engine/src/llm/ apps/sk/src/tests/ tests/lint/`) and the e2e
# suite. On a developer laptop those serialize to 10+ minutes per
# push because the local Postgres pool runs single-tenant; CI parallelises
# across runners and finishes the same tests in ~2 minutes. Running
# the full gate locally on every push pushed real engineering time
# into "wait for the test pipeline" mode and led to the harness
# session occasionally killing the gate mid-run.
#
# The compromise: the hook owns the FAST checks (lint + typecheck +
# build) so a malformed change can't reach origin. The full
# unit/integration + e2e gate stays in CI (.github/workflows/ci.yml),
# which is the canonical authority anyway.
#
# Run the full local gate explicitly with `bun run verify` when you
# want CI parity before pushing.

set -e

echo "[pre-push] fast gate — lint + typecheck + build (full tests run in CI)"

echo "[pre-push] 1/3 biome (lint)"
bun run lint

echo "[pre-push] 2/3 tsc (typecheck)"
bun run typecheck

echo "[pre-push] 3/3 build all binaries"
bun run build:sk
bun run build:engine

echo "[pre-push] all green — full test suite will run on CI"
