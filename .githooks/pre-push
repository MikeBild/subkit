#!/usr/bin/env bash
# Pre-push gate — fast subset of the CI quality gate.
#
# Pre-fix the hook also ran the full unit/integration suite (`bun test
# apps/engine/src/conversations/ apps/engine/src/execution/tests/
# apps/engine/src/llm/ apps/sk/src/tests/ tests/lint/`) and the e2e
# suite. On a developer laptop those serialize to 10+ minutes per
# push because the local Postgres pool runs single-tenant; CI parallelises
# across runners and finishes the same tests in ~2 minutes. Running
# the full gate locally on every push pushed real engineering time
# into "wait for the test pipeline" mode and led to the harness
# session occasionally killing the gate mid-run.
#
# The compromise: the hook owns the FAST checks (lint + typecheck +
# build) so a malformed change can't reach origin. The full
# unit/integration + e2e gate stays in CI (.github/workflows/ci.yml),
# which is the canonical authority anyway.
#
# Run the full local gate explicitly with `bun run verify` when you
# want CI parity before pushing.

set -e

echo "[pre-push] fast gate — lint + typecheck + build + drift + determinism + invariants (full tests run in CI)"

echo "[pre-push] 1/7 biome (lint)"
bun run lint

echo "[pre-push] 2/7 tsc (typecheck)"
bun run typecheck

echo "[pre-push] 3/7 determinism lint (no Date.now / randomBytes / Math.random in *.test.ts)"
# CI's build job runs `scripts/check-determinism.ts` and fails on
# `errors > 0`. Running it locally here means a `randomBytes(...)`
# inside a `.test.ts` (or `Math.random()`, etc.) is caught before
# push instead of after the CI run. Each error in this lint always
# fails CI; warnings do not.
bun run test:determinism

echo "[pre-push] 4/7 audit:invariants (route layering, file size, tenant filter, etc.)"
# CI's invariants job runs the same script. The most common local-vs-
# CI drift caught here is `route_layering` (a route file importing a
# subsystem internal instead of the subsystem's index.ts barrel).
# Skip pr_template inside the hook (it requires PR_BODY which only
# CI sets); audit-invariants.ts auto-skips it without env.
bun run audit:invariants

echo "[pre-push] 5/7 openapi-drift (regenerate client; fail on diff)"
# Without this, adding/changing an engine route lands in main with
# the generated client at packages/cli-core/src/engine-api/ stale —
# CI's `check:openapi-drift` then fails on the same diff and the
# round-trip repeats. Better to catch the drift before the push.
bun run check:openapi-drift

echo "[pre-push] 6/7 commit-message gate (each new commit on this push)"
# Walks the commits being pushed via the pre-push stdin range and
# validates each header against scripts/check-commit-message.sh
# (header-max-length=100, conventional type-enum, subject-case).
# Pure bash — no commitlint dependency at push time.
zero=$(git hash-object --stdin < /dev/null | tr 'a-f0-9' '0')
msg_failed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && continue
  if ! bash scripts/check-commit-message.sh --range "$base..$local_sha"; then
    msg_failed=1
  fi
done
if [ "$msg_failed" -ne 0 ]; then
  echo "[pre-push] commit-message gate failed; fix the messages before pushing" >&2
  exit 1
fi

echo "[pre-push] 7/7 build all binaries"
bun run build:sk
bun run build:engine

echo "[pre-push] all green — full test suite will run on CI"
