#!/usr/bin/env bash
# Commit-msg gate — fail at commit time on a malformed conventional
# commit instead of letting a bad message land and forcing a rebase
# + force-push later (which is what bit this branch's first push).
#
# Implemented in pure bash to avoid pulling commitlint + ajv at
# commit time; mirrors the same rules CI's commitlint job enforces
# (header-max-length=100, conventional type-enum, subject-case).

exec bash "$(git rev-parse --show-toplevel)/scripts/check-commit-message.sh" "$1"
