#!/usr/bin/env bash
# Pre-commit hook — mirrors the CI quality gate so `git push` never
# ships a commit that fails lint. Fast path (<1 s): only checks files
# actually staged for this commit.
#
# What it does:
#   1. Collects every staged *.ts / *.tsx / *.js / *.json / *.md file.
#   2. Runs `bun x biome check --write --no-errors-on-unmatched` on
#      that list — auto-fixes import order, quote style, line length,
#      unused imports. Re-stages the fixed files so the commit carries
#      the fixes.
#   3. Runs `bun x biome check` (no --write) against the same list to
#      surface any errors biome could NOT auto-fix; those block the
#      commit.
#   4. Runs `bun x tsc --noEmit` ONLY when staged files touch TS — it
#      takes ~10 s so we gate it behind the shape check.
#
# Opt out for a single commit: `git commit --no-verify` (reserved for
# emergency recovery only; CI will still fail).
#
# Install: `sh scripts/setup-hooks.sh` once per clone — configures
# core.hooksPath to point here. Automatic via `bun install` (postinstall).

set -eu

# Colour helpers — no-op when stdout is not a tty.
if [ -t 1 ]; then
  red=$(printf '\033[31m'); green=$(printf '\033[32m'); yellow=$(printf '\033[33m'); reset=$(printf '\033[0m')
else
  red=''; green=''; yellow=''; reset=''
fi

# Collect staged files (Added, Copied, Modified, Renamed — never Deleted).
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

# Only the file types biome + tsc care about. Use grep -E instead of a
# pipe of cases so the hook remains portable across POSIX shells.
lintable=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|json|md)$' || true)
has_ts=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx)$' || true)

if [ -z "$lintable" ]; then
  exit 0
fi

printf '%b%s%b\n' "$yellow" "[pre-commit] biome check --write on ${lintable}" "$reset" | head -3

# 1. Auto-fix pass — safe fixes only. `--no-errors-on-unmatched` keeps
# the hook quiet when a staged file slipped into biome's ignore list.
# shellcheck disable=SC2086
if ! bun x biome check --write --no-errors-on-unmatched $lintable > /tmp/subkit-pre-commit.log 2>&1; then
  printf '%b[pre-commit] biome --write failed unexpectedly:%b\n' "$red" "$reset"
  cat /tmp/subkit-pre-commit.log | tail -40
  exit 1
fi

# Re-stage whatever biome touched so the commit carries the formatted
# code instead of the original unformatted version.
# shellcheck disable=SC2086
git add $lintable

# 2. Strict check — fails if biome still reports any errors (rules it
# can't auto-fix: type-level issues, unused imports with side effects,
# etc.).
# shellcheck disable=SC2086
if ! bun x biome check --no-errors-on-unmatched $lintable > /tmp/subkit-pre-commit.log 2>&1; then
  printf '%b[pre-commit] biome reported errors — commit blocked:%b\n' "$red" "$reset"
  cat /tmp/subkit-pre-commit.log | tail -60
  printf '\n%b[pre-commit] fix manually, then re-stage + re-commit. bypass with --no-verify only for emergencies.%b\n' "$yellow" "$reset"
  exit 1
fi

# 3. Typecheck — only when staged files include TS. Runs against the
# whole project because tsc has no --files-only mode; this is the
# trade-off for catching cross-file type breakage before CI.
if [ -n "$has_ts" ]; then
  printf '%b[pre-commit] tsc --noEmit%b\n' "$yellow" "$reset"
  if ! bun x tsc --noEmit > /tmp/subkit-pre-commit-tsc.log 2>&1; then
    printf '%b[pre-commit] typecheck failed — commit blocked:%b\n' "$red" "$reset"
    cat /tmp/subkit-pre-commit-tsc.log | tail -40
    exit 1
  fi
fi

printf '%b[pre-commit] ok%b\n' "$green" "$reset"
