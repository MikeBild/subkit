#!/usr/bin/env bash

set -eu

if [ -t 1 ]; then
  red=$(printf '\033[31m'); green=$(printf '\033[32m'); yellow=$(printf '\033[33m'); reset=$(printf '\033[0m')
else
  red=''; green=''; yellow=''; reset=''
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

lintable=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|json|md)$' || true)
has_ts=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx)$' || true)

if [ -z "$lintable" ]; then
  exit 0
fi

printf '%b%s%b\n' "$yellow" "[pre-commit] biome check --write on ${lintable}" "$reset" | head -3

# shellcheck disable=SC2086
if ! bun x biome check --write --no-errors-on-unmatched $lintable > /tmp/subkit-pre-commit.log 2>&1; then
  printf '%b[pre-commit] biome --write failed unexpectedly:%b\n' "$red" "$reset"
  cat /tmp/subkit-pre-commit.log | tail -40
  exit 1
fi

# shellcheck disable=SC2086
git add $lintable

# shellcheck disable=SC2086
if ! bun x biome check --no-errors-on-unmatched $lintable > /tmp/subkit-pre-commit.log 2>&1; then
  printf '%b[pre-commit] biome reported errors — commit blocked:%b\n' "$red" "$reset"
  cat /tmp/subkit-pre-commit.log | tail -60
  printf '\n%b[pre-commit] fix manually, then re-stage + re-commit. bypass with --no-verify only for emergencies.%b\n' "$yellow" "$reset"
  exit 1
fi

if [ -n "$has_ts" ]; then
  printf '%b[pre-commit] tsc --noEmit%b\n' "$yellow" "$reset"
  if ! bun x tsc --noEmit > /tmp/subkit-pre-commit-tsc.log 2>&1; then
    printf '%b[pre-commit] typecheck failed — commit blocked:%b\n' "$red" "$reset"
    cat /tmp/subkit-pre-commit-tsc.log | tail -40
    exit 1
  fi
fi

printf '%b[pre-commit] ok%b\n' "$green" "$reset"
