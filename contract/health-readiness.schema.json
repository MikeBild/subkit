{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mikebild:contracts:health-readiness:v1",
  "title": "Product family health and readiness contract",
  "oneOf": [{ "$ref": "#/$defs/health" }, { "$ref": "#/$defs/ready" }],
  "$defs": {
    "service": {
      "enum": ["subkit", "contentkit", "wikikit", "workkit", "watchkit", "codekit"]
    },
    "checkState": {
      "enum": ["pass", "fail"]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "service", "version"],
      "properties": {
        "status": { "const": "ok" },
        "service": { "$ref": "#/$defs/service" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "service", "version", "checks"],
      "properties": {
        "status": { "enum": ["ready", "not_ready"] },
        "service": { "$ref": "#/$defs/service" },
        "version": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "object",
          "required": ["lifecycle", "database"],
          "properties": {
            "lifecycle": { "$ref": "#/$defs/checkState" },
            "database": { "$ref": "#/$defs/checkState" },
            "storage": { "$ref": "#/$defs/checkState" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "service": { "const": "contentkit" } },
            "required": ["service"]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "object",
                "required": ["storage"],
                "properties": { "storage": { "$ref": "#/$defs/checkState" } }
              }
            }
          },
          "else": {
            "properties": {
              "checks": {
                "type": "object",
                "properties": { "storage": false }
              }
            }
          }
        }
      ]
    }
  }
}
