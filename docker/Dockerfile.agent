# Tunnel agent — separate compile target, shared codebase.

FROM oven/bun:1.3-slim AS builder
ARG TARGETARCH
WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

RUN mkdir -p /out \
    && BUN_TARGET="bun-linux-$(if [ "$TARGETARCH" = "amd64" ]; then echo x64; else echo arm64; fi)" \
    && bun build apps/agent/src/index.ts \
        --compile \
        --target="$BUN_TARGET" \
        --outfile=/out/tunnel-agent

# --- runtime image ---------------------------------------------------------
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/tunnel-agent /usr/local/bin/tunnel-agent

ENV NODE_ENV=production \
    LOG_FORMAT=ndjson

USER nobody

ENTRYPOINT ["/usr/local/bin/tunnel-agent"]
