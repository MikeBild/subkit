# Multi-stage build: compile the engine binary with Bun, ship on a slim Debian base.
#
# BuildKit sets TARGETARCH automatically (amd64 / arm64) so the compiled
# binary always matches the target platform. The builder stage runs on the
# same platform as the runtime image thanks to Docker's `--platform` handling,
# so a plain `bun build --compile` without an explicit --target produces a
# native binary for the target arch. We pass --target explicitly only to be
# extra clear in the build log.

FROM oven/bun:1.3-slim AS builder
ARG TARGETARCH
ARG ENGINE_VERSION=0.0.0-dev
ENV ENGINE_VERSION=${ENGINE_VERSION}
WORKDIR /app

# Copy dependency manifests first so docker can cache the install layer
# across rebuilds when source files change.
COPY package.json bun.lock bunfig.toml tsconfig.json tsconfig.base.json biome.json ./
COPY scripts ./scripts

# Cache bun's install directory between builds for faster rebuilds.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# Install Chromium for the playwright-crawl discovery strategy. Done before
# the source copy so the layer is cached as long as package.json / bun.lock
# don't change. `--with-deps` lays down the apt packages Chromium needs
# (libnss3, libatk1.0-0, etc.). The apt cache mount keeps deb downloads
# warm across rebuilds.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    bunx playwright install chromium --with-deps

COPY apps ./apps
COPY packages ./packages

# Produce a statically compiled engine binary targeting the host arch.
# TARGETARCH is amd64 or arm64; Bun's target triples are bun-linux-x64
# and bun-linux-arm64.
#
# `--define BUILD_VERSION="\"x.y.z\""` bakes the version directly into
# the compiled binary so an operator running it without the runtime
# ENGINE_VERSION env var still gets the right number on /v1/health.
# Note: bun's --define replaces the identifier with the literal value
# parsed as JS — `"3.2.0"` is the JS string literal we want, so the
# argument we pass on the shell must be exactly `BUILD_VERSION="3.2.0"`
# (one set of quotes, after shell expansion). Earlier variants used
# nested escapes which leaked literal quotes into the runtime string.
RUN mkdir -p /out \
    && BUN_TARGET="bun-linux-$(if [ "$TARGETARCH" = "amd64" ]; then echo x64; else echo arm64; fi)" \
    && echo "compiling engine for $BUN_TARGET (version=$ENGINE_VERSION)" \
    && bun build apps/engine/src/index.ts \
        --compile \
        --target="$BUN_TARGET" \
        --define BUILD_VERSION=\"${ENGINE_VERSION}\" \
        --outfile=/out/engine

# --- runtime image ---------------------------------------------------------
FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/engine /usr/local/bin/engine
COPY --from=builder /app/apps/engine/src/conversations/seed/skills /usr/local/share/subkit/skills

# Bundled sk + tunnel-agent binaries served by the /install/sk-* and
# /install/agent-* routes. The build context's docker/binaries/ holds
# whatever scripts/release/embed-binaries.sh placed there:
#   * CI release: every shipping platform + matching SHA256SUMS, so
#     `curl https://my-engine/install | bash` works for every operator
#     without GitHub egress.
#   * Local / fork build: only the `.gitkeep` placeholder is present.
#     The install routes find no SHA256SUMS, return 404, and the
#     install script falls back to GitHub Releases — graceful
#     degradation for anyone who didn't run embed-binaries.sh.
RUN mkdir -p /usr/local/share/subkit/binaries
COPY --chown=nobody:nogroup docker/binaries /usr/local/share/subkit/binaries
ENV SUBKIT_BINARIES_DIR=/usr/local/share/subkit/binaries

# Writable data directory for blob offload fallback when S3 is not configured.
RUN mkdir -p /var/data/blobs && chown -R nobody:nogroup /var/data/blobs

# v3.5+: subkit.config.json lives at /etc/subkit/subkit.config.json in
# production (see config/loader.ts defaultConfigPath). The engine
# auto-creates this file on first boot to persist the auto-generated
# session secret + runtime PUT /v1/settings writes. Pre-create the
# directory chown'd to the runtime user so the non-root container can
# atomic-rename into it without an EACCES on /etc.
RUN mkdir -p /etc/subkit \
    && chown nobody:nogroup /etc/subkit \
    && chmod 0700 /etc/subkit

ARG ENGINE_VERSION=0.0.0-dev
ENV NODE_ENV=production \
    LOG_FORMAT=ndjson \
    PORT=3000 \
    ENGINE_VERSION=${ENGINE_VERSION}

EXPOSE 3000 3001

USER nobody

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/v1/health" >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/engine"]
