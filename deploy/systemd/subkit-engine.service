; Subkit engine — single-binary workflow engine.
;
; Replaces the docker-compose `engine` service for production. The
; binary at /usr/local/bin/engine is the same `bun build --compile`
; artifact CI publishes; deploy = scp + `systemctl restart`.
;
; Layout on the host (matches scripts/do-bootstrap.sh):
;   /usr/local/bin/engine          — binary (chmod 755)
;   /etc/subkit/.env               — operator env (chmod 600, owned by subkit)
;   /etc/subkit/subkit.config.json — runtime config (auto-created on first
;                                    boot if absent; engine reads it via
;                                    apps/engine/src/config/loader.ts)
;   /var/lib/subkit/blobs          — file storage
;
; Ops:
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now subkit-engine
;   sudo systemctl status subkit-engine
;   sudo journalctl -u subkit-engine -f
;
; The engine is a data-workflow runtime — no docker socket, no
; container spawning. The 4.2.0 retire of the `tool` step removed the
; docker dependency, so this unit can drop the `docker` group.

[Unit]
Description=Subkit workflow engine (single binary; replaces docker-compose engine since 4.2.0)
Documentation=https://github.com/MikeBild/subkit
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=subkit
Group=subkit

; Single binary — no shell, no node, no bun runtime install needed.
ExecStart=/usr/local/bin/engine

; Operator-edited env. Required (no `-` prefix): MASTER_KEY is
; consumed before the config loader runs and a missing .env produces
; a Zod parse failure inside the binary that's only visible via
; `journalctl`. Letting systemd report the error at unit-load time is
; easier to diagnose. `do-bootstrap.sh` step 9 places the file.
EnvironmentFile=/etc/subkit/.env

; Hard-pin the listen port so an operator override in /etc/subkit/.env
; can't drift the Caddy upstream silently. If the port ever needs to
; change it moves here AND in deploy/caddy/Caddyfile in lockstep.
Environment=PORT=3000

; Belt-and-suspenders for the config-loader path resolution. systemd
; auto-exports CONFIGURATION_DIRECTORY=/etc/subkit (from
; `ConfigurationDirectory=subkit` below), which the loader honors as
; the primary signal. NODE_ENV=production is the fallback the loader
; falls through to if CONFIGURATION_DIRECTORY ever isn't set
; (manual `systemd-run`, downgraded systemd, etc.) so the engine
; never picks up /var/lib/subkit/subkit.config.json by accident from
; the WorkingDirectory below.
Environment=NODE_ENV=production

; Production default for local file storage. The schema default is
; "" (empty → /tmp/sk-files fallback, which is ephemeral and wipes
; on reboot). Seeding via SK_OVERRIDE_ keeps the schema honest
; (tests + dev still get the empty default) while the production
; binary gets the persistent path created by do-bootstrap.sh.
Environment=SK_OVERRIDE_STORAGE_FILES_DIR=/var/lib/subkit/files

; Working dir + state. systemd auto-creates these with mode 0750
; under the unit's User/Group when the *Directory= keys are set.
WorkingDirectory=/var/lib/subkit
StateDirectory=subkit
ConfigurationDirectory=subkit

; Restart policy: process exit -> 5s cooldown -> retry, capped at 3
; restarts in 60s before systemd gives up. Operator sees the failure
; in `systemctl status` and journalctl.
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

; Hardening — least privilege, no shell escape paths.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
; ^ Bun JIT requires write+exec memory; can't enable.

; Filesystem ACL — engine writes to its config dir (auto-create the
; config file on first boot) and state dir (file-storage blobs, drift
; reports). Logs go to journald via stdout/stderr — no /var/log/subkit
; needed.
ReadWritePaths=/etc/subkit /var/lib/subkit

; Resource limits — keep boot footprint sane on a small host.
LimitNOFILE=65536
LimitNPROC=4096

; ---------------------------------------------------------------------------
; Memory containment — cgroup limits + OOM-killer steering.
;
; The production droplet is 4 GB total and co-hosts Postgres. Without a
; cgroup memory cap the engine grows until the *kernel global OOM killer*
; fires (constraint=CONSTRAINT_NONE, task_memcg=…/subkit-engine.service),
; which can also kill anyone else who happens to allocate at the wrong
; tick. Three documented incidents to date: 2026-05-20, 2026-05-21, and
; the 2026-05-28 morning burst (six engine kills in two hours, RSS ~3.6 GB
; on a 4 GB host, all global OOM not cgroup OOM). The 502s the user sees
; at Cloudflare are the cut-off in-flight HTTP requests; the
; `worker_expired` audit entries on conversation turns are pg-boss jobs
; whose worker process was killed mid-turn and then expired in the
; 10-minute visibility window before the restarted engine could finish
; them (jobs have retryLimit:0 — they are not idempotent, see
; queue/handlers/conversation-run-turn-dlq.ts).
;
; The fix has two halves:
;   1. Cap *this* unit so memory pressure becomes a *cgroup* OOM (kills
;      the engine only, leaves Postgres + Caddy + system alone). The
;      caps below assume the 8 GB droplet sk runs on after the
;      2026-06-17 downsize (16 -> 8 GB; the 16 GB tier was idle-heavy
;      over-provisioning — 39-day measured working set peaked at
;      4.75 GB during the May pressure era and ~2.5 GB in the weeks
;      after the 6.20.x memory-stabilization releases, with ZERO kernel
;      OOM kills on 16 GB). 7 G hard cap + 6 G soft throttle clears the
;      historical 4.75 GB transient peak (so a normal turn never
;      throttles) while still containing a runaway turn within the
;      engine cgroup: 7 G engine + ~0.7 G Postgres/Caddy/OS resident
;      fits inside 8 GB physical, with the 4 GB swapfile as overflow.
;      Conversation turns have been observed to allocate several GB of
;      transient memory on the FIRST POST /v1/conversations after a
;      cold start (the runner buffers the assembled prompt, tool
;      palette, AI SDK streamText state, and tokenizer tables before
;      the LLM round-trip even begins). Earlier, tighter caps tripped
;      MemoryHigh throttling so hard the engine stopped responding to
;      /v1/health locally and the deploy/smoke chain tore itself down —
;      6 G soft is deliberately set ABOVE the observed peak to avoid
;      that. If worker_expired recurs, raise these (or resize back up)
;      via a drop-in override at
;      /etc/systemd/system/subkit-engine.service.d/memory.conf.
;   2. Steer the kernel global OOM killer (if it ever fires anyway from
;      a noisy neighbour) to prefer killing the engine over Postgres.
;      Postgres has a default oom_score_adj of 0; +500 here makes the
;      engine ~10x more likely to be picked. The restart loop above
;      brings it back; killing Postgres would corrupt the pgboss queue
;      and force a manual recovery pass.
;
; ManagedOOMSwap=kill enrolls systemd-oomd if present so swap thrashing
; (the host has a 4 GB swapfile from the 2026-05-20 mitigation) triggers
; a clean kill before the kernel OOM has to make a hostile pick.
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=2G
OOMScoreAdjust=500
ManagedOOMSwap=kill
; ---------------------------------------------------------------------------

; Network — engine listens on 3000 (HTTP).
; Caddy in front handles 443→3000 routing.

[Install]
WantedBy=multi-user.target
